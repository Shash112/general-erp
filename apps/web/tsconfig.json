{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@general-erp/core": ["../../packages/core/src/index.ts"],
      "@general-erp/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
